# Copie para o ambiente da central real e preencha com valores de producao.
# Nao commitar o arquivo real preenchido.

APP_SYSTEM_ROLE=saas_central
APP_CENTRAL_CONTROL_ENABLED=1

APP_INSTALLER_ACTIVATION_FROM=no-reply@seudominio.com.br
MAILER_DSN=smtp://usuario:senha@smtp.seudominio.com.br:587

APP_INSTALLER_ACTIVATION_SIGNING_KEY=trocar-por-chave-com-32-ou-mais-caracteres
APP_INSTALLATION_SESSION_SIGNING_KEY=trocar-por-chave-compartilhada-com-runtime
APP_INSTALLER_ARTIFACT_SIGNING_KEY=trocar-por-chave-de-assinatura-dos-artefatos

APP_INSTALLER_MANIFEST_URL=https://downloads.seudominio.com.br/construtor/installer-manifest.json
APP_INSTALLER_DOCKER_COMPOSE_URL=https://downloads.seudominio.com.br/construtor/compose.production.yaml
APP_INSTALLER_PACKAGE_URL=https://downloads.seudominio.com.br/construtor/construtor-pg-package.zip

# Fallback temporario. Preferir admin.instalacao-licencas.
APP_INSTALLER_ACTIVATION_SUBSCRIBERS={}

# Fallback temporario. Preferir admin.instalacao-tokens.
APP_INSTALLER_ACTIVATION_SERVICE_TOKEN=
