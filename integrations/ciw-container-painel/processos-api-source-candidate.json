{
  "providerType": "generic",
  "code": "motor_progress_container_processos",
  "name": "Motor Progress — Processos do Container",
  "status": "active",
  "baseUrl": "http://127.0.0.1:19910/med/web",
  "authMode": "header_static",
  "authHeaders": {
    "X-Containers-Token": "__RUNTIME_SECRET__"
  },
  "timeoutSeconds": 120,
  "responseContract": "sursum-programs",
  "operations": [
    {
      "code": "painel_read",
      "name": "Painel do Container — Consultar",
      "method": "POST",
      "type": "list",
      "path": "/SursumPrograms/containers-painel",
      "itemsPath": "data",
      "requestContextFields": [
        "container_id"
      ],
      "bodyTemplate": {
        "operation": "read",
        "resource": "painel"
      }
    },
    {
      "code": "painel_get",
      "name": "Painel do Container — Detalhar",
      "method": "POST",
      "type": "detail",
      "path": "/SursumPrograms/containers-painel",
      "itemPath": "data",
      "requestContextFields": [
        "container_id"
      ],
      "bodyTemplate": {
        "operation": "get",
        "resource": "painel"
      }
    },
    {
      "code": "gerar_versao",
      "name": "Gerar versão de custo",
      "type": "custom",
      "method": "POST",
      "allowProcess": true,
      "path": "/SursumPrograms/containers-processos",
      "itemPath": "data",
      "requestContextFields": [
        "container_id"
      ],
      "bodyTemplate": {
        "resource": "versoes",
        "operation": "gerar"
      }
    },
    {
      "code": "fechar_custos",
      "name": "Fechar custos dos itens",
      "type": "custom",
      "method": "POST",
      "allowProcess": true,
      "path": "/SursumPrograms/containers-processos",
      "itemPath": "data",
      "requestContextFields": [
        "container_id"
      ],
      "bodyTemplate": {
        "resource": "custos",
        "operation": "fechar"
      }
    },
    {
      "code": "sincronizar_impostos",
      "name": "Sincronizar impostos",
      "type": "custom",
      "method": "POST",
      "allowProcess": true,
      "path": "/SursumPrograms/containers-processos",
      "itemPath": "data",
      "requestContextFields": [
        "container_id"
      ],
      "bodyTemplate": {
        "resource": "impostos",
        "operation": "sincronizar"
      }
    }
  ]
}
