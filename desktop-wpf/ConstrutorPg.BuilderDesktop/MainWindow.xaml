<Window x:Class="ConstrutorPg.BuilderDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:models="clr-namespace:ConstrutorPg.BuilderDesktop.Models"
        xmlns:vm="clr-namespace:ConstrutorPg.BuilderDesktop.ViewModels"
        mc:Ignorable="d"
        Title="Construtor PG Desktop MVP"
        Width="1440"
        Height="900"
        MinWidth="1200"
        MinHeight="720"
        Background="#FFF4F6F8">
    <Window.Resources>
        <HierarchicalDataTemplate DataType="{x:Type vm:ExplorerNodeViewModel}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Glyph}" Margin="0,0,8,0" />
                <TextBlock Text="{Binding Title}" />
            </StackPanel>
        </HierarchicalDataTemplate>

        <DataTemplate DataType="{x:Type models:BuilderModuleModel}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="Modulo" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Codigo" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Nome" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Abreviacao" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{Binding Abbreviation, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Faixa inicial" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{Binding NumberStart, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Faixa final" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{Binding NumberEnd, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                    <CheckBox Content="Ativo" IsChecked="{Binding Enabled}" />
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>

        <DataTemplate DataType="{x:Type models:BuilderEntityModel}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="Entidade" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Codigo" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Nome" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Tipo" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" SelectedItem="{Binding EntityType, UpdateSourceTrigger=PropertyChanged}">
                            <sys:String>persistence</sys:String>
                            <sys:String>query</sys:String>
                            <sys:String>io</sys:String>
                        </ComboBox>
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Tabela" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{Binding TableName, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Programa" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{Binding ProgramCode, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                    <CheckBox Content="Cadastro versionado" IsChecked="{Binding VersionedMaster}" Margin="0,0,0,6" />
                    <CheckBox Content="Criar tabela fisica" IsChecked="{Binding CreatePhysicalTable}" />
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>

        <DataTemplate DataType="{x:Type models:BuilderFieldModel}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="Campo" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Codigo" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Label" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Tipo de dado" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" SelectedItem="{Binding DataType, UpdateSourceTrigger=PropertyChanged}">
                            <sys:String>string</sys:String>
                            <sys:String>text</sys:String>
                            <sys:String>integer</sys:String>
                            <sys:String>decimal</sys:String>
                            <sys:String>boolean</sys:String>
                            <sys:String>date</sys:String>
                            <sys:String>datetime</sys:String>
                            <sys:String>custom_code</sys:String>
                        </ComboBox>
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Coluna fisica" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{Binding ColumnName, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Tamanho" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{Binding Length, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                    <CheckBox Content="Obrigatorio" IsChecked="{Binding Required}" Margin="0,0,0,6" />
                    <CheckBox Content="Chave primaria" IsChecked="{Binding PrimaryKey}" Margin="0,0,0,6" />
                    <CheckBox Content="Nao editavel" IsChecked="{Binding ReadOnly}" />
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:EmptySelectionViewModel}">
            <StackPanel>
                <TextBlock Text="Selecione um item" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
                <TextBlock TextWrapping="Wrap"
                           Text="Este MVP foi criado para validar a experiencia de arvore, propriedades contextuais e preview de estrutura sem alterar a interface web existente." />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#FF1F2937" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Construtor PG Desktop MVP" Foreground="White" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock Text="Arvore de objetos, painel contextual e preview JSON em memoria"
                               Foreground="#FFD1D5DB"
                               Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Novo modulo" Width="110" Margin="0,0,8,0" Command="{Binding AddModuleCommand}" />
                    <Button Content="Nova entidade" Width="110" Margin="0,0,8,0" Command="{Binding AddEntityCommand}" />
                    <Button Content="Novo campo" Width="100" Margin="0,0,8,0" Command="{Binding AddFieldCommand}" />
                    <Button Content="Atualizar preview" Width="120" Margin="0,0,8,0" Command="{Binding RefreshPreviewCommand}" />
                    <Button Content="Copiar JSON" Width="100" Command="{Binding CopyPreviewCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" />
            </StatusBarItem>
        </StatusBar>

        <Grid Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" BorderBrush="#FFD1D5DB" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,12,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Estrutura" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <TreeView x:Name="ExplorerTreeView"
                              ItemsSource="{Binding RootNodes}"
                              SelectedItemChanged="ExplorerTreeView_OnSelectedItemChanged" />
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Background="White" BorderBrush="#FFD1D5DB" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,12,0">
                <TabControl>
                    <TabItem Header="Resumo">
                        <Grid Margin="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="16" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedTitle}" FontSize="24" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding SelectedDescription}" Margin="0,6,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <Border Grid.Row="2" Background="#FFF9FAFB" BorderBrush="#FFE5E7EB" BorderThickness="1" CornerRadius="8" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="Objetivo desta tela" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                                    <TextBlock TextWrapping="Wrap"
                                               Text="Validar uma experiencia mais adequada para autoria complexa: selecao em arvore, contexto lateral de propriedades e preview estruturado, sem depender da interface web existente." />
                                    <TextBlock Margin="0,16,0,0" FontSize="16" FontWeight="SemiBold" Text="Escopo do MVP" />
                                    <TextBlock Margin="0,8,0,0" Text="- dados em memoria" />
                                    <TextBlock Text="- sem gravacao em banco" />
                                    <TextBlock Text="- sem integracao com backend nesta etapa" />
                                    <TextBlock Text="- base para evoluir depois para login, API e versionamento" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </TabItem>
                    <TabItem Header="Preview JSON">
                        <Grid Margin="8">
                            <TextBox Text="{Binding PreviewJson, Mode=OneWay}"
                                     FontFamily="Consolas"
                                     FontSize="13"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     IsReadOnly="True"
                                     TextWrapping="NoWrap" />
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>

            <Border Grid.Column="2" Background="White" BorderBrush="#FFD1D5DB" BorderThickness="1" CornerRadius="8" Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Propriedades" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <ContentControl Content="{Binding SelectedPayload}" />
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
