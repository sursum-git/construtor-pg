{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://construtor-pg.local/metadata/schemas/analytics-definition-v1.schema.json",
  "title": "Analytics Definition v1",
  "type": "object",
  "required": ["schemaVersion", "pageType", "screenId", "program", "analytics"],
  "properties": {
    "schemaVersion": { "type": "string" },
    "pageType": { "const": "analytics" },
    "screenId": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]+$" },
    "program": {
      "type": "object",
      "required": ["id", "title"],
      "properties": {
        "id": { "type": "string" },
        "module": { "type": "string" },
        "title": { "type": "string" },
        "version": { "type": "string" },
        "subtitle": { "type": "string" },
        "icon": { "type": "string" },
        "permission": { "type": ["string", "boolean", "null"] }
      },
      "additionalProperties": true
    },
    "permissions": { "type": "object" },
    "dataSource": {
      "type": "object",
      "properties": {
        "api": { "$ref": "#/$defs/endpointMap" }
      },
      "additionalProperties": true
    },
    "api": { "$ref": "#/$defs/endpointMap" },
    "analytics": {
      "type": "object",
      "required": ["datasets", "views"],
      "properties": {
        "version": { "type": "string" },
        "endpoints": { "$ref": "#/$defs/endpointMap" },
        "audit": { "$ref": "#/$defs/auditPolicy" },
        "datasets": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/dataset" }
        },
        "views": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/view" }
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "endpointMap": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          { "type": "string" },
          {
            "type": "object",
            "properties": {
              "endpointId": { "type": "string" },
              "actionId": { "type": "string" },
              "method": { "type": "string", "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "dataset": {
      "type": "object",
      "required": ["id", "source"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]+$" },
        "title": { "type": "string" },
        "source": {
          "type": "object",
          "required": ["type", "entityCode"],
          "properties": {
            "type": { "enum": ["entity", "persistence"] },
            "entityCode": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" }
          },
          "additionalProperties": false
        },
        "joins": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "entityCode", "localField", "foreignField"],
            "properties": {
              "id": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
              "type": { "enum": ["left", "inner"] },
              "source": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
              "entityCode": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
              "localField": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
              "foreignField": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" }
            },
            "additionalProperties": false
          }
        },
        "fields": { "type": "array", "items": { "$ref": "#/$defs/fieldRef" } },
        "dimensions": { "type": "array", "items": { "$ref": "#/$defs/fieldRef" } },
        "measures": { "type": "array", "items": { "$ref": "#/$defs/measure" } },
        "parameters": { "type": "array", "items": { "$ref": "#/$defs/parameter" } },
        "filters": { "$ref": "#/$defs/filterGroup" },
        "defaultSort": { "type": "array", "items": { "$ref": "#/$defs/sort" } },
        "limit": { "type": "integer", "minimum": 1, "maximum": 5000 },
        "executionMode": { "enum": ["live", "cached", "auto"] },
        "allowLiveFallback": { "type": "boolean" },
        "audit": { "$ref": "#/$defs/auditPolicy" },
        "cache": {
          "type": "object",
          "properties": {
            "ttlSeconds": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "fieldRef": {
      "oneOf": [
        { "type": "string" },
        {
          "type": "object",
          "required": ["field"],
          "properties": {
            "id": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
            "source": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
            "field": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)?$" },
            "label": { "type": "string" },
            "type": { "type": "string" },
            "format": { "type": "string" }
          },
          "additionalProperties": false
        }
      ]
    },
    "measure": {
      "type": "object",
      "required": ["id", "aggregate"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
        "source": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
        "field": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)?$" },
        "label": { "type": "string" },
        "aggregate": { "enum": ["count", "sum", "avg", "min", "max", "distinct_count"] },
        "format": { "type": "string" }
      },
      "additionalProperties": false
    },
    "parameter": {
      "type": "object",
      "required": ["id", "field"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
        "source": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
        "field": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)?$" },
        "label": { "type": "string" },
        "type": { "type": "string" },
        "operator": { "$ref": "#/$defs/operator" },
        "defaultValue": {},
        "options": { "type": "array" }
      },
      "additionalProperties": false
    },
    "filterGroup": {
      "type": "object",
      "properties": {
        "logic": { "enum": ["and", "or"] },
        "filters": {
          "type": "array",
          "items": {
            "oneOf": [
              { "$ref": "#/$defs/filterGroup" },
              { "$ref": "#/$defs/filter" }
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "filter": {
      "type": "object",
      "required": ["field", "operator"],
      "properties": {
        "source": { "type": "string" },
        "field": { "type": "string" },
        "operator": { "$ref": "#/$defs/operator" },
        "value": {}
      },
      "additionalProperties": false
    },
    "operator": {
      "enum": ["eq", "neq", "contains", "notcontains", "startswith", "endswith", "in", "between", "range", "gte", "lte", "gt", "lt", "isnull", "isnotnull", "relative_date", "relativedate"]
    },
    "sort": {
      "type": "object",
      "required": ["field"],
      "properties": {
        "field": { "type": "string" },
        "dir": { "enum": ["asc", "desc"] }
      },
      "additionalProperties": false
    },
    "auditPolicy": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "includeCacheHits": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "view": {
      "type": "object",
      "required": ["id", "type", "datasetId"],
      "properties": {
        "id": { "type": "string" },
        "type": { "enum": ["grid", "pivot", "chart", "kpi", "dashboard"] },
        "title": { "type": "string" },
        "datasetId": { "type": "string" },
        "categoryField": { "type": "string" },
        "valueField": { "type": "string" },
        "seriesType": { "type": "string" },
        "valueFormat": { "type": "string" },
        "tiles": { "type": "array" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
