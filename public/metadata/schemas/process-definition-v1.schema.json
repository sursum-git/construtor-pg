{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://construtor-pg.local/schemas/process-definition-v1.schema.json",
  "title": "Process Definition v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "pageType",
    "program",
    "process"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string"
    },
    "pageType": {
      "const": "process"
    },
    "screenId": {
      "type": "string"
    },
    "contextFields": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": [
          "field",
          "required",
          "readonly"
        ],
        "properties": {
          "field": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "required": {
            "const": true
          },
          "readonly": {
            "const": true
          },
          "filter": {
            "type": "boolean"
          },
          "createDefault": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "program": {
      "type": "object",
      "required": [
        "title"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "screenId": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "subtitle": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "help": {
          "type": "object"
        },
        "logs": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "permissions": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "boolean",
          "string"
        ]
      }
    },
    "dataSource": {
      "type": "object",
      "properties": {
        "api": {
          "type": "object",
          "properties": {
            "process": {
              "$ref": "#/$defs/endpoint"
            },
            "status": {
              "$ref": "#/$defs/endpoint"
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "process": {
      "type": "object",
      "required": [
        "parameters"
      ],
      "properties": {
        "parameters": {
          "type": "object",
          "required": [
            "fields"
          ],
          "properties": {
            "title": {
              "type": "string"
            },
            "fields": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/parameterField"
              }
            }
          },
          "additionalProperties": true
        },
        "actions": {
          "type": "object",
          "properties": {
            "process": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string"
                },
                "icon": {
                  "type": "string"
                },
                "permission": {
                  "type": "string"
                },
                "confirmation": {
                  "type": "object",
                  "required": [
                    "message"
                  ],
                  "properties": {
                    "message": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1000
                    },
                    "confirmText": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": true
            }
          },
          "additionalProperties": true
        },
        "endpoints": {
          "type": "object",
          "properties": {
            "process": {
              "$ref": "#/$defs/endpoint"
            },
            "status": {
              "$ref": "#/$defs/endpoint"
            }
          },
          "additionalProperties": true
        },
        "wait": {
          "type": "object",
          "properties": {
            "mode": {
              "enum": [
                "auto",
                "sse",
                "polling",
                "none"
              ]
            },
            "message": {
              "type": "string"
            },
            "pollIntervalSeconds": {
              "type": "number",
              "minimum": 1
            },
            "eventSourceUrl": {
              "type": "string"
            },
            "events": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "url": {
                  "type": "string"
                }
              },
              "additionalProperties": true
            }
          },
          "additionalProperties": true
        },
        "result": {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "message",
                "grid",
                "report",
                "job",
                "properties"
              ]
            },
            "openReportInNewTab": {
              "type": "boolean"
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "apiCompany": {
      "$ref": "#/$defs/apiCompanyDescriptor"
    }
  },
  "$defs": {
    "endpoint": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "endpointId": {
              "type": "string"
            },
            "actionId": {
              "type": "string"
            },
            "url": {
              "type": "string"
            },
            "method": {
              "enum": [
                "GET",
                "POST"
              ]
            }
          },
          "additionalProperties": true
        }
      ]
    },
    "parameterField": {
      "type": "object",
      "required": [
        "field",
        "label"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "field": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "type": {
          "enum": [
            "text",
            "string",
            "number",
            "integer",
            "decimal",
            "date",
            "datetime",
            "boolean",
            "enum",
            "option",
            "dropdown",
            "array"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "readonly": {
          "type": "boolean"
        },
        "defaultValue": {},
        "placeholder": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "technicalProperties": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "section": {
                        "type": "string"
                      },
                      "label": {
                        "type": "string"
                      },
                      "value": {},
                      "critical": {
                        "type": "boolean"
                      }
                    },
                    "additionalProperties": true
                  }
                ]
              }
            },
            {
              "type": "object",
              "additionalProperties": true
            }
          ]
        },
        "options": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "properties": {
                  "value": {},
                  "text": {
                    "type": "string"
                  },
                  "label": {
                    "type": "string"
                  },
                  "id": {}
                },
                "additionalProperties": true
              }
            ]
          }
        },
        "itemType": {
          "const": "integer"
        },
        "optionsSource": {
          "type": "object",
          "required": [
            "endpointId"
          ],
          "properties": {
            "endpointId": {
              "type": "string",
              "pattern": "^options\\.[A-Za-z_][A-Za-z0-9_]*$"
            },
            "parameterFields": {
              "type": "array",
              "minItems": 1,
              "maxItems": 2,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^(?!context$|operation$|resource$|parameters$)[a-z][a-z0-9_]*$"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    },
    "apiCompanyDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "moduleId",
        "screenId",
        "endpointModes"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "moduleId": {
          "type": "string",
          "pattern": "^[a-z0-9_-]{1,64}$"
        },
        "screenId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "endpointModes": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "mode",
              "operation"
            ],
            "properties": {
              "mode": {
                "enum": [
                  "shared",
                  "company",
                  "record"
                ]
              },
              "operation": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              }
            }
          }
        }
      }
    }
  },
  "additionalProperties": true
}
