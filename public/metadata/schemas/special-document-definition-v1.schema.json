{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://construtor-pg.local/metadata/schemas/special-document-definition-v1.schema.json",
  "title": "Special Document Definition v1",
  "type": "object",
  "required": ["schemaVersion", "pageType", "screenId", "program", "specialDocument"],
  "properties": {
    "schemaVersion": { "type": "string" },
    "pageType": { "const": "special_document" },
    "screenId": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]+$" },
    "program": {
      "type": "object",
      "required": ["id", "title"],
      "properties": {
        "id": { "type": "string" },
        "screenId": { "type": "string" },
        "module": { "type": "string" },
        "entity": { "type": "string" },
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "version": { "type": "string" },
        "icon": { "type": "string" },
        "permission": {
          "oneOf": [
            { "type": "boolean" },
            { "type": "string" }
          ]
        }
      },
      "additionalProperties": true
    },
    "permissions": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          { "type": "boolean" },
          { "type": "string" }
        ]
      }
    },
    "dataSource": {
      "type": "object",
      "properties": {
        "api": {
          "type": "object",
          "properties": {
            "schema": { "$ref": "#/$defs/endpointRef" },
            "render": { "$ref": "#/$defs/endpointRef" },
            "export": { "$ref": "#/$defs/endpointRef" }
          },
          "additionalProperties": { "$ref": "#/$defs/endpointRef" }
        }
      },
      "additionalProperties": true
    },
    "specialDocument": {
      "type": "object",
      "required": ["classification", "renderEngine", "source", "parameters", "outputs"],
      "properties": {
        "version": { "type": "string" },
        "classification": {
          "type": "object",
          "required": ["documentKind"],
          "properties": {
            "documentKind": { "type": "string" },
            "documentProfile": { "type": "string", "enum": ["special"] }
          },
          "additionalProperties": false
        },
        "renderEngine": { "type": "string", "enum": ["native_stub", "native"] },
        "endpoints": {
          "type": "object",
          "properties": {
            "schema": { "$ref": "#/$defs/endpointRef" },
            "render": { "$ref": "#/$defs/endpointRef" },
            "export": { "$ref": "#/$defs/endpointRef" }
          },
          "additionalProperties": { "$ref": "#/$defs/endpointRef" }
        },
        "source": {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": { "type": "string", "enum": ["operational", "analytic"] },
            "entityCode": { "type": "string" },
            "analyticsScreenId": { "type": "string" },
            "analyticsDatasetId": { "type": "string" }
          },
          "additionalProperties": false
        },
        "parameters": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "label", "type"],
            "properties": {
              "id": { "type": "string" },
              "field": { "type": "string" },
              "label": { "type": "string" },
              "type": { "type": "string" },
              "operator": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "layout": {
          "type": "object",
          "properties": {
            "title": { "type": "string" },
            "subtitle": { "type": "string" },
            "notes": { "type": "string" },
            "issuerName": { "type": "string" },
            "issuerDocument": { "type": "string" },
            "beneficiaryName": { "type": "string" },
            "beneficiaryDocument": { "type": "string" },
            "dueDate": { "type": "string" },
            "barcodeText": { "type": "string" }
          },
          "additionalProperties": false
        },
        "printing": {
          "type": "object",
          "properties": {
            "deliveryMode": { "type": "string", "enum": ["download", "qz_tray"] },
            "qzTray": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" },
                "printerName": { "type": "string" },
                "jobName": { "type": "string" },
                "copies": { "type": "integer", "minimum": 1, "maximum": 10 }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "outputs": {
          "type": "object",
          "properties": {
            "html": { "type": "boolean" },
            "pdf": { "type": "boolean" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "endpointRef": {
      "oneOf": [
        { "type": "string" },
        {
          "type": "object",
          "properties": {
            "endpointId": { "type": "string" },
            "actionId": { "type": "string" },
            "method": { "type": "string" }
          },
          "additionalProperties": true
        }
      ]
    }
  },
  "additionalProperties": true
}
