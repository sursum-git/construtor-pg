{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://construtor-pg.local/metadata/schemas/master-detail-definition-v1.schema.json",
  "title": "Master Detail Definition v1",
  "type": "object",
  "required": ["schemaVersion", "pageType", "screenId", "program", "master", "details"],
  "properties": {
    "schemaVersion": { "type": "string" },
    "pageType": { "const": "master_detail" },
    "screenId": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]+$" },
    "program": {
      "type": "object",
      "required": ["id", "title"],
      "properties": {
        "id": { "type": "string" },
        "screenId": { "type": "string" },
        "module": { "type": "string" },
        "entity": { "type": "string" },
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "version": { "type": "string" },
        "icon": { "type": "string" },
        "permission": {
          "oneOf": [
            { "type": "boolean" },
            { "type": "string" }
          ]
        }
      },
      "additionalProperties": true
    },
    "permissions": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          { "type": "boolean" },
          { "type": "string" }
        ]
      }
    },
    "dataSource": {
      "type": "object",
      "properties": {
        "api": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/endpointRef" }
        }
      },
      "additionalProperties": true
    },
    "runtime": {
      "type": "object",
      "additionalProperties": true
    },
    "master": { "$ref": "#/$defs/section" },
    "details": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          { "$ref": "#/$defs/section" },
          {
            "type": "object",
            "required": ["parentField"],
            "properties": {
              "parentField": { "type": "string" }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "endpointRef": {
      "oneOf": [
        { "type": "string" },
        {
          "type": "object",
          "required": ["endpointId"],
          "properties": {
            "endpointId": { "type": "string" },
            "actionId": { "type": "string" },
            "method": { "type": "string", "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] },
            "url": { "type": "string" }
          },
          "additionalProperties": true
        }
      ]
    },
    "section": {
      "type": "object",
      "required": ["id", "entity", "idField", "fields", "grid"],
      "properties": {
        "id": { "type": "string" },
        "entity": { "type": "string" },
        "title": { "type": "string" },
        "singularTitle": { "type": "string" },
        "subtitle": { "type": "string" },
        "idField": { "type": "string" },
        "displayField": { "type": "string" },
        "api": {
          "type": "object",
          "properties": {
            "read": { "$ref": "#/$defs/endpointRef" },
            "get": { "$ref": "#/$defs/endpointRef" },
            "create": { "$ref": "#/$defs/endpointRef" },
            "update": { "$ref": "#/$defs/endpointRef" },
            "delete": { "$ref": "#/$defs/endpointRef" }
          },
          "additionalProperties": { "$ref": "#/$defs/endpointRef" }
        },
        "query": {
          "type": "object",
          "properties": {
            "sort": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["field", "dir"],
                "properties": {
                  "field": { "type": "string" },
                  "dir": { "enum": ["asc", "desc"] }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": true
        },
        "fields": {
          "type": "array",
          "items": { "$ref": "#/$defs/field" }
        },
        "grid": {
          "type": "object",
          "properties": {
            "columns": {
              "type": "array",
              "items": { "$ref": "#/$defs/gridColumn" }
            }
          },
          "additionalProperties": true
        },
        "totals": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["field"],
            "properties": {
              "field": { "type": "string" },
              "label": { "type": "string" },
              "type": { "type": "string" }
            },
            "additionalProperties": true
          }
        },
        "records": {
          "type": "array",
          "items": { "type": "object" }
        }
      },
      "additionalProperties": true
    },
    "field": {
      "type": "object",
      "required": ["id", "label", "type"],
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "label": { "type": "string" },
        "type": { "type": "string" },
        "required": { "type": "boolean" },
        "hidden": { "type": "boolean" },
        "readonly": { "type": "boolean" },
        "readonlyOnEdit": { "type": "boolean" },
        "decimals": { "type": "integer" },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["value", "text"],
            "properties": {
              "value": {},
              "text": { "type": "string" }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "gridColumn": {
      "type": "object",
      "required": ["field"],
      "properties": {
        "field": { "type": "string" },
        "title": { "type": "string" },
        "width": {
          "oneOf": [
            { "type": "integer" },
            { "type": "string" }
          ]
        },
        "align": { "enum": ["left", "center", "right"] },
        "format": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
