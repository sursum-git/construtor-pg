{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://construtor-pg.local/metadata/schemas/regulated-document-definition-v1.schema.json",
  "title": "Regulated Document Definition v1",
  "type": "object",
  "required": ["schemaVersion", "pageType", "screenId", "program", "regulatedDocument"],
  "properties": {
    "schemaVersion": { "type": "string" },
    "pageType": { "const": "regulated_document" },
    "screenId": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]+$" },
    "program": {
      "type": "object",
      "required": ["id", "title"],
      "properties": {
        "id": { "type": "string" },
        "screenId": { "type": "string" },
        "module": { "type": "string" },
        "entity": { "type": "string" },
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "version": { "type": "string" },
        "icon": { "type": "string" },
        "permission": {
          "oneOf": [
            { "type": "boolean" },
            { "type": "string" }
          ]
        }
      },
      "additionalProperties": true
    },
    "permissions": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          { "type": "boolean" },
          { "type": "string" }
        ]
      }
    },
    "dataSource": {
      "type": "object",
      "properties": {
        "api": {
          "type": "object",
          "properties": {
            "schema": { "$ref": "#/$defs/endpointRef" },
            "prepare": { "$ref": "#/$defs/endpointRef" },
            "render": { "$ref": "#/$defs/endpointRef" },
            "issue": { "$ref": "#/$defs/endpointRef" },
            "verify": { "$ref": "#/$defs/endpointRef" },
            "artifact": { "$ref": "#/$defs/endpointRef" }
          },
          "additionalProperties": { "$ref": "#/$defs/endpointRef" }
        }
      },
      "additionalProperties": true
    },
    "regulatedDocument": {
      "type": "object",
      "required": ["track", "documentType", "complianceProfile", "renderEngine", "source", "parameters", "outputs", "artifactPolicy", "verification", "retention"],
      "properties": {
        "version": { "type": "string" },
        "track": { "type": "string", "enum": ["fiscal", "banking", "logistics"] },
        "documentType": { "type": "string" },
        "complianceProfile": { "type": "string", "enum": ["near_homologated"] },
        "renderEngine": { "type": "string", "enum": ["internal"] },
        "endpoints": {
          "type": "object",
          "properties": {
            "schema": { "$ref": "#/$defs/endpointRef" },
            "prepare": { "$ref": "#/$defs/endpointRef" },
            "render": { "$ref": "#/$defs/endpointRef" },
            "issue": { "$ref": "#/$defs/endpointRef" },
            "verify": { "$ref": "#/$defs/endpointRef" },
            "artifact": { "$ref": "#/$defs/endpointRef" }
          },
          "additionalProperties": { "$ref": "#/$defs/endpointRef" }
        },
        "source": {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": { "type": "string", "enum": ["operational", "analytic"] },
            "entityCode": { "type": "string" },
            "analyticsScreenId": { "type": "string" },
            "analyticsDatasetId": { "type": "string" }
          },
          "additionalProperties": false
        },
        "parameters": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "label", "type"],
            "properties": {
              "id": { "type": "string" },
              "field": { "type": "string" },
              "label": { "type": "string" },
              "type": { "type": "string" },
              "operator": { "type": "string" },
              "required": { "type": "boolean" }
            },
            "additionalProperties": false
          }
        },
        "outputs": {
          "type": "object",
          "properties": {
            "html": { "type": "boolean" },
            "pdf": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "artifactPolicy": {
          "type": "object",
          "properties": {
            "storeCanonicalPayload": { "type": "boolean" },
            "storeArtifact": { "type": "boolean" },
            "defaultFormat": { "type": "string", "enum": ["html", "pdf"] }
          },
          "additionalProperties": false
        },
        "verification": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "algorithm": { "type": "string", "enum": ["sha256"] },
            "publicPath": { "type": "string" },
            "label": { "type": "string" }
          },
          "additionalProperties": false
        },
        "retention": {
          "type": "object",
          "properties": {
            "keepPayload": { "type": "boolean" },
            "keepArtifact": { "type": "boolean" },
            "storeDays": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        },
        "layout": {
          "type": "object",
          "properties": {
            "title": { "type": "string" },
            "subtitle": { "type": "string" },
            "notes": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "endpointRef": {
      "oneOf": [
        { "type": "string" },
        {
          "type": "object",
          "properties": {
            "endpointId": { "type": "string" },
            "actionId": { "type": "string" },
            "method": { "type": "string" }
          },
          "additionalProperties": true
        }
      ]
    }
  },
  "additionalProperties": true
}
