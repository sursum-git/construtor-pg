{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "crud-definition-v1.schema.json",
  "title": "Page Definition v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "pageType",
    "program",
    "permissions",
    "dataSource",
    "dataModel",
    "crud"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string"
    },
    "pageType": {
      "type": "string",
      "const": "crud"
    },
    "program": {
      "type": "object",
      "required": ["id", "module", "entity", "title"],
      "properties": {
        "id": {
          "type": "string"
        },
        "module": {
          "type": "string"
        },
        "entity": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "subtitle": {
          "type": "string",
          "maxLength": 80
        },
        "subtitleTooltip": {
          "type": "string",
          "maxLength": 300
        },
        "help": {
          "$ref": "#/$defs/help"
        },
        "logs": {
          "$ref": "#/$defs/logs"
        }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "security": {
      "type": "object",
      "properties": {
        "userGroups": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "groups": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "currentUser": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "groups": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "runtime": {
      "type": "object",
      "properties": {
        "entityCode": {
          "type": "string"
        },
        "programId": {
          "type": "string"
        },
        "lock": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "lockTtlSeconds": {
              "type": "integer",
              "minimum": 30
            },
            "heartbeatIntervalSeconds": {
              "type": "integer",
              "minimum": 10
            },
            "modes": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["edit", "update", "delete"]
              }
            }
          },
          "additionalProperties": true
        },
        "messages": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "pollIntervalSeconds": {
              "type": "integer",
              "minimum": 10
            },
            "events": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "url": {
                  "type": "string"
                }
              },
              "additionalProperties": true
            },
            "eventSourceUrl": {
              "type": "string"
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "dataSource": {
      "type": "object",
      "required": ["api"],
      "properties": {
        "api": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/endpoint"
          }
        }
      }
    },
    "dataModel": {
      "type": "object",
      "required": ["primaryKey", "fields"],
      "properties": {
        "primaryKey": {
          "type": "string"
        },
        "fields": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/field"
          }
        }
      }
    },
    "crud": {
      "type": "object",
      "required": ["grid", "form"],
      "properties": {
        "features": {
          "type": "object",
          "properties": {
            "filterPanel": {
              "type": "boolean",
              "default": true
            }
          },
          "additionalProperties": false
        },
        "query": {
          "$ref": "#/$defs/query"
        },
        "filter": {
          "$ref": "#/$defs/filter"
        },
        "grid": {
          "$ref": "#/$defs/grid"
        },
        "form": {
          "$ref": "#/$defs/form"
        },
        "userLayout": {
          "type": "object"
        }
      }
    }
  },
  "$defs": {
    "endpoint": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "endpointId": {
          "type": "string"
        },
        "actionId": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "method": {
          "type": "string",
          "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"]
        }
      },
      "additionalProperties": true
    },
    "printConfig": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "label": {
          "type": "string"
        },
        "icon": {
          "type": "string"
        },
        "fileName": {
          "type": "string"
        },
        "requiresRecord": {
          "type": "boolean",
          "default": true
        },
        "formats": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["excel", "pdf", "csv"]
          }
        },
        "options": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string",
                "enum": ["excel", "pdf", "csv"]
              },
              {
                "$ref": "#/$defs/printOption"
              }
            ]
          }
        },
        "excel": {
          "type": "object"
        },
        "pdf": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "printOption": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "format": {
          "type": "string",
          "enum": ["excel", "pdf", "csv"]
        },
        "type": {
          "type": "string",
          "enum": ["excel", "pdf", "csv"]
        },
        "label": {
          "type": "string"
        },
        "icon": {
          "type": "string"
        },
        "fileName": {
          "type": "string"
        },
        "source": {
          "type": "string",
          "enum": ["browser", "api"]
        },
        "mode": {
          "type": "string",
          "enum": ["browser", "api"]
        },
        "action": {
          "type": "string"
        },
        "browser": {
          "type": "boolean"
        },
        "endpointId": {
          "type": "string"
        },
        "actionId": {
          "type": "string"
        },
        "endpoint": {
          "$ref": "#/$defs/endpoint"
        },
        "api": {
          "$ref": "#/$defs/endpoint"
        },
        "url": {
          "type": "string"
        },
        "method": {
          "type": "string",
          "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"]
        },
        "pageMethod": {
          "type": "string",
          "enum": ["GET", "POST"]
        },
        "submitMethod": {
          "type": "string",
          "enum": ["GET", "POST"]
        },
        "target": {
          "type": "string",
          "enum": ["request", "window", "newTab"]
        },
        "openAs": {
          "type": "string",
          "enum": ["request", "window", "newTab"]
        },
        "successMessage": {
          "type": "string"
        },
        "errorMessage": {
          "type": "string"
        },
        "confirm": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "help": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "title": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": ["text", "link", "video"]
        },
        "summary": {
          "type": "string"
        },
        "body": {
          "type": "string"
        },
        "linkUrl": {
          "type": "string"
        },
        "linkText": {
          "type": "string"
        },
        "videoUrl": {
          "type": "string"
        },
        "readEndpoint": {
          "$ref": "#/$defs/endpoint"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/helpItem"
          }
        }
      }
    },
    "helpItem": {
      "type": "object",
      "required": ["id", "title"],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": ["text", "link", "video"]
        },
        "summary": {
          "type": "string"
        },
        "body": {
          "type": "string"
        },
        "linkUrl": {
          "type": "string"
        },
        "linkText": {
          "type": "string"
        },
        "videoUrl": {
          "type": "string"
        }
      }
    },
    "logs": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "title": {
          "type": "string",
          "default": "Logs"
        },
        "url": {
          "type": "string"
        },
        "linkText": {
          "type": "string",
          "default": "Abrir logs em nova aba"
        }
      },
      "additionalProperties": false
    },
    "field": {
      "type": "object",
      "required": ["type", "label"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "string",
            "text",
            "integer",
            "decimal",
            "number",
            "boolean",
            "date",
            "datetime",
            "email",
            "enum",
            "lookup",
            "hidden"
          ]
        },
        "label": {
          "type": "string"
        },
        "editable": {
          "type": "boolean"
        },
        "nullable": {
          "type": "boolean"
        },
        "format": {
          "type": "string"
        },
        "editor": {
          "type": "string"
        },
        "validation": {
          "type": "object"
        },
        "options": {
          "type": "array"
        }
      }
    },
    "query": {
      "type": "object",
      "properties": {
        "defaultPageSize": {
          "type": "integer"
        },
        "pageSizes": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "defaultSort": {
          "type": "array"
        }
      }
    },
    "filter": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["window"]
        },
        "mode": {
          "type": "string",
          "enum": ["basic"]
        },
        "title": {
          "type": "string"
        },
        "openOnLoad": {
          "type": "boolean",
          "default": false
        },
        "maximizeFilter": {
          "type": "boolean",
          "default": false
        },
        "waitForSubmitOnLoad": {
          "type": "boolean",
          "default": true
        },
        "showAppliedFilters": {
          "type": "boolean",
          "default": true
        },
        "showAppliedSummary": {
          "type": "boolean",
          "default": true
        },
        "tabs": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "otherTitle": {
              "type": "string",
              "default": "Outros"
            },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "title", "fields"],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  },
                  "fields": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "grid": {
      "type": "object",
      "required": ["columns"],
      "properties": {
        "id": {
          "type": "string"
        },
        "freezeColumns": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "fields": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Campos que podem ser congelados. Vazio permite todas as colunas visiveis.",
              "default": []
            }
          },
          "additionalProperties": false
        },
        "mobile": {
          "$ref": "#/$defs/mobileGrid"
        },
        "ai": {
          "$ref": "#/$defs/gridAi"
        },
        "print": {
          "$ref": "#/$defs/printConfig"
        },
        "groupable": {
          "type": "boolean"
        },
        "columns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/gridColumn"
          }
        },
        "toolbar": {
          "type": "array"
        },
        "bulkActions": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "label": {
              "type": "string"
            },
            "icon": {
              "type": "string"
            },
            "selectable": {
              "type": "string"
            },
            "actions": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "label", "action"],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "label": {
                    "type": "string"
                  },
                  "icon": {
                    "type": "string"
                  },
                  "action": {
                    "type": "string"
                  },
                  "endpointId": {
                    "type": "string"
                  },
                  "actionId": {
                    "type": "string"
                  },
                  "endpoint": {
                    "$ref": "#/$defs/endpoint"
                  },
                  "permission": {
                    "type": "string"
                  },
                  "value": {},
                  "data": {
                    "type": "object"
                  },
                  "confirm": {
                    "type": "object"
                  },
                  "successMessage": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "rowActions": {
          "type": "array"
        }
      }
    },
    "gridAi": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "provider": {
          "type": "string",
          "enum": ["mock", "service"],
          "default": "mock"
        },
        "tool": {
          "type": "string",
          "enum": ["smartbox"],
          "default": "smartbox"
        },
        "activeMode": {
          "type": "string",
          "enum": ["Search", "AIAssistant"]
        },
        "placeholder": {
          "type": "string"
        },
        "searchPlaceholder": {
          "type": "string"
        },
        "searchEnabled": {
          "type": "boolean",
          "default": true
        },
        "searchFields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "promptSuggestions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "serviceUrl": {
          "type": "string"
        },
        "service": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "gridColumn": {
      "type": "object",
      "required": ["field", "title"],
      "properties": {
        "field": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "width": {
          "type": ["integer", "string"]
        },
        "visible": {
          "type": "boolean"
        },
        "filterable": {
          "type": "boolean"
        },
        "sortable": {
          "type": "boolean"
        },
        "groupable": {
          "type": "boolean"
        },
        "format": {
          "type": "string"
        },
        "align": {
          "type": "string",
          "enum": ["left", "center", "right"]
        }
      }
    },
    "mobileGrid": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "breakpoint": {
          "type": "integer",
          "default": 720
        },
        "mode": {
          "type": "string",
          "enum": ["columns", "template"]
        },
        "columns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "title": {
          "type": "string"
        },
        "cardActions": {
          "type": "boolean",
          "default": true
        },
        "template": {
          "$ref": "#/$defs/mobileGridTemplate"
        }
      },
      "additionalProperties": false
    },
    "mobileGridTemplate": {
      "type": "object",
      "properties": {
        "titleField": {
          "type": "string"
        },
        "subtitleField": {
          "type": "string"
        },
        "badges": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tabs": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "title", "fields"],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  },
                  "fields": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "form": {
      "type": "object",
      "required": ["id", "mode", "layout"],
      "properties": {
        "id": {
          "type": "string"
        },
        "mode": {
          "type": "string",
          "enum": ["popup"]
        },
        "layout": {
          "type": "string",
          "enum": ["tabs", "sections", "single", "steps"]
        },
        "width": {
          "type": "integer"
        },
        "maximizeForm": {
          "type": "boolean",
          "default": false
        },
        "maximizeOnOpen": {
          "type": "boolean",
          "default": false,
          "description": "Alias de maximizeForm."
        },
        "behavior": {
          "type": "object",
          "properties": {
            "closeOnSave": {
              "type": "boolean",
              "default": true
            },
            "closeOnCancel": {
              "type": "boolean",
              "default": false
            }
          },
          "additionalProperties": false
        },
        "navigation": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            }
          },
          "additionalProperties": false
        },
        "mobile": {
          "type": "object",
          "properties": {
            "breakpoint": {
              "type": "integer",
              "default": 720
            },
            "showHeaderActions": {
              "type": "boolean",
              "default": false
            }
          },
          "additionalProperties": false
        },
        "concurrencyWarning": {
          "$ref": "#/$defs/formConcurrencyWarning"
        },
        "concurrentWarning": {
          "$ref": "#/$defs/formConcurrencyWarning",
          "description": "Alias de concurrencyWarning."
        },
        "logs": {
          "$ref": "#/$defs/logs"
        },
        "print": {
          "$ref": "#/$defs/printConfig"
        },
        "otherActions": {
          "oneOf": [
            {
              "$ref": "#/$defs/formOtherActions"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/formButton"
              }
            }
          ]
        },
        "situation": {
          "$ref": "#/$defs/formSituation"
        },
        "statusFlow": {
          "$ref": "#/$defs/formSituation"
        },
        "title": {
          "type": "object"
        },
        "tabs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/formTab"
          }
        },
        "sections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/formSection"
          }
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/formStep"
          }
        },
        "buttons": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/formButton"
          }
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/formEvent"
          }
        }
      }
    },
    "formConcurrencyWarning": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "actions": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": ["edit", "delete"]
                  }
                }
              ]
            },
            "visibleIn": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": ["edit", "delete"]
                  }
                }
              ]
            },
            "modes": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": ["edit", "delete"]
                  }
                }
              ]
            },
            "title": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "editMessage": {
              "type": "string"
            },
            "deleteMessage": {
              "type": "string"
            },
            "confirm": {
              "type": "boolean",
              "default": true
            },
            "blocking": {
              "type": "boolean",
              "default": true
            },
            "confirmText": {
              "type": "string"
            },
            "cancelText": {
              "type": "string"
            },
            "confirmIcon": {
              "type": "string"
            },
            "themeColor": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "enum": ["success", "error", "info", "warning"]
            },
            "width": {
              "type": "integer"
            },
            "messages": {
              "type": "object",
              "properties": {
                "edit": {
                  "type": "string"
                },
                "delete": {
