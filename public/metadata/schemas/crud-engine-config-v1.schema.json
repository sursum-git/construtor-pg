{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "crud-engine-config-v1.schema.json",
  "title": "CRUD Engine Global Configuration v1",
  "type": "object",
  "required": ["schemaVersion"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "theme": {
      "type": "object",
      "properties": {
        "kendoTheme": {
          "type": "string",
          "default": "kendo/styles/default-blue.css"
        },
        "defaultMode": {
          "type": "string",
          "enum": ["light", "dark"],
          "default": "light"
        },
        "allowUserSwitch": {
          "type": "boolean",
          "default": true
        },
        "persistUserChoice": {
          "type": "boolean",
          "default": true
        },
        "storageKey": {
          "type": "string",
          "default": "crudEngine.theme"
        },
        "tokens": {
          "type": "object",
          "properties": {
            "light": {
              "$ref": "#/$defs/themeTokens"
            },
            "dark": {
              "$ref": "#/$defs/themeTokens"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "help": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "title": {
          "type": "string",
          "default": "Ajuda e novidades"
        },
        "storageKey": {
          "type": "string",
          "default": "crudEngine.help.seen"
        },
        "readEndpoint": {
          "description": "Endpoint opcional chamado quando o usuario le novidades novas.",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/helpReadEndpoint"
            },
            {
              "type": "null"
            }
          ]
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "title", "kind"],
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "enum": ["text", "link", "video"]
              },
              "publishedAt": {
                "type": "string"
              },
              "summary": {
                "type": "string"
              },
              "body": {
                "type": "string"
              },
              "videoUrl": {
                "type": "string"
              },
              "linkUrl": {
                "type": "string"
              },
              "linkText": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "default": []
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "helpReadEndpoint": {
      "type": "object",
      "required": ["url"],
      "properties": {
        "url": {
          "type": "string"
        },
        "method": {
          "type": "string",
          "enum": ["POST", "PUT", "PATCH"],
          "default": "POST"
        }
      },
      "additionalProperties": false
    },
    "themeTokens": {
      "type": "object",
      "properties": {
        "background": { "type": "string" },
        "surface": { "type": "string" },
        "border": { "type": "string" },
        "text": { "type": "string" },
        "muted": { "type": "string" },
        "title": { "type": "string" },
        "accent": { "type": "string" },
        "accentSoft": { "type": "string" },
        "accentBorder": { "type": "string" },
        "inputBackground": { "type": "string" },
        "readonlyBackground": { "type": "string" },
        "messageBackground": { "type": "string" },
        "errorBorder": { "type": "string" },
        "errorBackground": { "type": "string" },
        "buttonBackground": { "type": "string" },
        "buttonHoverBackground": { "type": "string" },
        "buttonBorder": { "type": "string" },
        "buttonText": { "type": "string" },
        "buttonPrimaryBackground": { "type": "string" },
        "buttonPrimaryHoverBackground": { "type": "string" },
        "buttonPrimaryText": { "type": "string" },
        "notificationBackground": { "type": "string" },
        "notificationText": { "type": "string" },
        "danger": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
